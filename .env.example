# Supabase project Settings > API. Add the same variables in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Supabase Auth user who may use the private CRM. Do not enable public Auth signups.
ADMIN_EMAIL=you@example.com

# Optional: Cloudflare Turnstile keys for extra spam protection on the public form.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
